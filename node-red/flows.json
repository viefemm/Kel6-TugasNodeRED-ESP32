    {
        "id": "mqtt_in_temperature",
        "type": "mqtt in",
        "z": "tab_flow_kel6",
        "name": "mqtt in  pens/klp6/+/temperature",
        "topic": "pens/klp6/+/temperature",
        "qos": "0",
        "datatype": "utf8",
        "broker": "broker_hivemq_kel6",
        "nl": false,
        "rap": true,
        "rh": 0,
        "inputs": 0,
        "x": 190,
        "y": 100,
        "wires": [
            [
                "fn_ambil_nama_ruang"
            ]
        ]
    },
    {
        "id": "fn_ambil_nama_ruang",
        "type": "function",
        "z": "tab_flow_kel6",
        "name": "ambil nama ruang",
        "func": "// Topic: pens/klp6/<nama_ruang>/temperature\nlet parts = msg.topic.split('/');\nlet room = parts[2] || 'unknown';\n\n// Pemetaan nama ruang agar terindeks rapi di legend Chart\nlet roomMap = {\n    'ruang1': 'Ruang 1',\n    'ruang2': 'Ruang 2',\n    'ruang3': 'Ruang 3',\n    'ruang4': 'Ruang 4'\n};\n\nmsg.topic = roomMap[room] || room;\nmsg.payload = parseFloat(msg.payload);\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 470,
        "y": 100,
        "wires": [
            [
                "chart_suhu",
                "debug_suhu"
            ]
        ]
    },
